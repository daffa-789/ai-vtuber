{
  "name": "silver-wolf",
  "version": "0.1.0",
  "private": true,
  "description": "Silver Wolf — AI companion. Monorepo TypeScript (paritas arsitektur Airi).",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sidecar:build": "cd sidecar && go build -o ../bin/silverwolf-sidecar.exe .",
    "sidecar:test": "cd sidecar && go test ./...",
    "dev": "electron-vite --config apps/stage-tamagotchi/electron.vite.config.ts dev",
    "dev:tamagotchi": "electron-vite --config apps/stage-tamagotchi/electron.vite.config.ts dev",
    "build": "npm run sidecar:build && electron-vite --config apps/stage-tamagotchi/electron.vite.config.ts build",
    "build:win": "npm run build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run && npm run sidecar:test",
    "test:ts": "vitest run",
    "voice:convert": "tsx packages/pipelines-audio/scripts/pth2onnx.ts",
    "spike:rvc": "tsx packages/pipelines-audio/scripts/spike-rvc.ts",
    "assets:verify": "node scripts/verify-assets.mjs",
    "ukur:latensi": "node scripts/ukur/ukur-p0.mjs",
    "ukur:tag": "node scripts/ukur/ukur-tag.mjs",
    "clean": "rimraf out apps/stage-tamagotchi/release node_modules",
    "turbo:typecheck": "tsc --noEmit -p tsconfig.json",
    "turbo:test": "vitest run",
    "turbo:build": "npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@mintplex-labs/piper-tts-web": "^1.0.5",
    "onnxruntime-node": "^1.20.1",
    "onnxruntime-web": "^1.20.1",
    "pinia": "^2.3.0",
    "piper-tts-web": "^1.1.2",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "rvc-onnx-web": "^1.0.0",
    "vue": "^3.5.13",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "happy-dom": "^15.11.7",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.5",
    "typescript": "^5.9.3",
    "unocss": "^0.65.4",
    "vite": "^6.0.7",
    "vite-plugin-static-copy": "^3.1.2",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "ai.silverwolf.companion",
    "productName": "Silver Wolf",
    "directories": {
      "output": "apps/stage-tamagotchi/release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "apps/stage-tamagotchi/resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "bin/silverwolf-sidecar.exe",
        "to": "bin/silverwolf-sidecar.exe"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "apps/stage-tamagotchi/resources/icon.ico",
      "artifactName": "Silver-Wolf-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Silver Wolf"
    }
  }
}
