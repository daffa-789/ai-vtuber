# Paket internal di-consume sebagai sumber TS (tanpa langkah build).
# Link workspace agar Vite/tsx bisa me-resolve @silverwolf/*.
link-workspace-packages=true
prefer-workspace-packages=true
# Hoisting ketat pnpm (bawaan) dipertahankan; jangan longgar.
strict-peer-dependencies=false

# Skrip lifecycle paket DIMATIKAN.
# Alasan: beberapa postinstall (esbuild, turbo) memanggil binary Windows yang
# diblokir kebijakan keamanan mesin ini (wmic.exe) sehingga `pnpm install` gagal
# di tengah. Semua kebutuhan runtime tetap terpenuhi tanpa postinstall:
#   - esbuild: binary datang dari paket opsional @esbuild/win32-x64;
#   - turbo:   binary sudah ikut paket turbo-windows-64.
# Yang MEMANG butuh postinstall: electron (mengunduh binary ~150 MB). Itu
# dijalankan eksplisit saat Fase 5, bukan lewat `pnpm install` biasa.
ignore-scripts=true
