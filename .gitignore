node_modules/
dist/
# Lingkungan Python: interpreter + salinan paket, bukan sumber.
.venv/
__pycache__/
*.pyc
.env
# Salinan .env (mis. cadangan saat menguji) berisi API key yang sama.
.env.*
!.env.example
.shots/
# Log sementara (mis. sidecar yang dijalankan dari skrip uji).
*.log

# Aset berlisensi Live2D: diunduh ulang dengan `python scripts/unduh_aset.py`,
# bukan diedarkan lewat repositori ini.
public/live2dcubismcore.min.js
public/vad/
public/ort/

# Model karakter sendiri: berkas sumber + hasil pasang, tetap di mesin ini.
# SELURUH public/models/ dikecualikan, bukan cuma penyihir: lisensi Live2D
# melarang modelnya diedarkan sebagai berkas lepas, dan silverwolf (19 MB) akan
# ikut ter-commit kalau baris ini menyebut satu folder saja.
public/models/

# Aset jalur suara, disediakan scripts/sedia_suara.py, bukan untuk di-commit:
# voice Piper 61 MB, model dasar RVC (hubert + rmvpe) ~730 MB, checkpoint Furina.
aset/suara/piper/
aset/suara/rvc/
aset/suara/model-dasar/
# Model Whisper untuk mic lokal (base 142 MB / small 470 MB): disediakan
# scripts/sedia_stt.py, bukan untuk di-commit.
aset/suara/whisper/
# Hasil sintesis + berkas temp + jejak ukur. `var/` sengaja di luar web/ dan
# public/ supaya statis.py tidak pernah bisa menyajikannya lewat HTTP.
var/
# Model LLM offline (GGUF): diunduh dengan `python scripts/unduh_model.py`,
# ukuran besar (>700 MB), tidak untuk di-commit ke Git.
model/
*.gguf

# Binary llama.cpp (llama-server + DLL Vulkan) hasil scripts/unduh_llama.py:
# 92 MB pihak ketiga, bisa dibangkitkan ulang, dan bukan sumber proyek ini.
bin/


