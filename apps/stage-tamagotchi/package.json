{
  "name": "@silverwolf/stage-tamagotchi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. apps/stage-tamagotchi --passWithNoTests",
    "clean": "rimraf out release node_modules"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-static-copy": "catalog:",
    "vitest": "catalog:"
  },
  "build": {
    "appId": "ai.silverwolf.companion",
    "productName": "Silver Wolf",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico",
      "artifactName": "Silver-Wolf-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Silver Wolf"
    }
  },
  "description": "Silver Wolf offline AI desktop companion",
  "author": "Silver Wolf Project"
}
