{
  "name": "@silverwolf/server",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. apps/server --passWithNoTests",
    "clean": "rimraf node_modules"
  },
  "dependencies": {
    "@silverwolf/core-agent": "workspace:*",
    "@silverwolf/core-character": "workspace:*",
    "@silverwolf/core-config": "workspace:*",
    "@silverwolf/server-runtime": "workspace:*"
  },
  "devDependencies": { "tsx": "catalog:", "typescript": "catalog:", "vitest": "catalog:" }
}
