    "piper-tts-web": "catalog:",
    "onnxruntime-web": "catalog:"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "^2.2.0",
    "vite-plugin-static-copy": "catalog:"
  }
