# =============================================================================
#  Contoh konfigurasi HuoHuo AI Vtuber
#
#  Salin ke `.env` di akar repo, lalu sesuaikan. Hanya kunci yang disebut di
#  SINI yang benar-benar dibaca kode — kunci lain diabaikan tanpa peringatan.
#
#  Semua nilai di bawah adalah DEFAULT yang sama dengan yang dipakai aplikasi,
#  jadi `.env` boleh berisi sedikit baris saja. Sumber kebenaran default ada di
#  `huohuo/profil_suara.py` (suara) dan `huohuo/config.py` (sisanya).
#
#  Cara menyalakan stack:
#     start_llm.bat      -> otak LLM di :8080
#     start_rvc.bat      -> suara     di :8081
#     python main.py     -> jendela HuoHuo
# =============================================================================

# ── Otak LLM ─────────────────────────────────────────────────────────────────
# Aplikasi HANYA menjadi klien server OpenAI-compatible di luar proses ini.
# Model GGUF dipilih oleh start_llm.bat, bukan oleh aplikasi.
VTUBER_LLAMA_ENDPOINT=http://127.0.0.1:8080/v1
VTUBER_LLAMA_TIMEOUT_DETIK=120

# ── Piper TTS ────────────────────────────────────────────────────────────────
# Jalur binary Piper. Tidak dibundel, jadi harus diisi kalau mau ada suara.
VTUBER_PIPER_PATH=data/piper/piper/piper.exe
# Prosodi Piper (length_scale / noise_scale / noise_w).
VTUBER_TTS_PIPER_PANJANG=0.9
VTUBER_TTS_PIPER_NOISE=0.667
VTUBER_TTS_PIPER_NOISE_W=0.8

# ── RVC: timbre karakter ─────────────────────────────────────────────────────
# `tidak` = pakai suara Piper generik, layanan :8081 tidak diperlukan.
VTUBER_RVC=ya
VTUBER_RVC_MODEL=HuoHuo
VTUBER_RVC_VERSI=v2
# rmvpe | pm | harvest  (harvest terukur lebih kasar pada sumber Piper)
VTUBER_RVC_F0=rmvpe
# Semitone. F0 sumber Piper 261,7 Hz; -2 -> 233,2 Hz.
# Menurunkan transpose justru MENAikkan kecerahan spektrum, jadi jangan
# menurunkannya untuk mencari suara "lebih gelap".
VTUBER_RVC_TRANSPOSE=-2
# Proteksi konsonan 0..1. Makin tinggi makin sedikit konsonan diregenerasi.
VTUBER_RVC_PROTEKSI=0.6
# Median filter kontur pitch (bingkai) dan campuran amplop volume 0..1.
VTUBER_RVC_PENCUCIAN=3
VTUBER_RVC_CAMPUR_RMS=0.8
# Bobot retrieval index 0..1. Tuas utama kemiripan karakter.
VTUBER_RVC_INDEKS_LAJU=0.6

# Lokasi folder model & alamat layanan (normalnya tidak perlu diubah).
# VTUBER_RVC_DIR=assets/rvc/HuoHuo
# VTUBER_RVC_PORT=8081
VTUBER_RVC_URL=http://127.0.0.1:8081
VTUBER_RVC_TIMEOUT_DETIK=180

# ── Koreksi nada pasca-konversi ──────────────────────────────────────────────
# Vocoder RVC menaikkan energi di atas 6 kHz ~16 kali dibanding sumber Piper;
# itulah "cempreng". Shelf tinggi memotongnya, shelf rendah mengembalikan badan.
# Masih kasar -> EQ_TINGGI_DB=-16 atau EQ_TINGGI_HZ=5000
# Mendengung -> EQ_TINGGI_DB=-8  atau EQ_TINGGI_HZ=7000
VTUBER_RVC_EQ=ya
VTUBER_RVC_EQ_TINGGI_HZ=6000
VTUBER_RVC_EQ_TINGGI_DB=-12
VTUBER_RVC_EQ_RENDAH_HZ=200
VTUBER_RVC_EQ_RENDAH_DB=1.5

# ── Siklus hidup layanan RVC (hemat RAM) ─────────────────────────────────────
# Layanan menahan ~2,5 GB saat aktif. Melepas model dari DALAM proses terbukti
# tidak mengembalikan memori (gc + trim hanya memulihkan 0,06 GB), jadi yang
# dilakukan adalah layanan BERHENTI sendiri setelah menganggur sekian detik --
# hanya proses yang mati benar-benar mengembalikan RAM. Adapter aplikasi
# menyalakannya lagi saat dibutuhkan, jadi tidak ada yang perlu dinyalakan
# tangan. Kalimat pertama setelah idle membayar ~29-38 dtk, sisanya ~6 dtk.
#   MUAT_BOOT=ya    -> dimuat segera saat layanan start
#   IDLE_HAPUS=0    -> jangan pernah berhenti
VTUBER_RVC_MUAT_BOOT=tidak
VTUBER_RVC_IDLE_HAPUS=180

# Boleh tidaknya adapter menyalakan ulang layanan RVC secara otomatis.
# Matikan hanya kalau kamu lebih suka menjalankan start_rvc.bat sendiri.
VTUBER_RVC_AUTO_MULAI=ya
# Lama maksimum menunggu layanan siap setelah dinyalakan otomatis (detik).
VTUBER_RVC_SIAP_DETIK=90
# Lokasi python rvc-env dan skrip layanan. Bawaan sudah benar selama folder
# rvc-env/ dan rvc/ ada di akar repo.
# VTUBER_RVC_PYTHON=rvc-env/Scripts/python.exe

# ── Jendela UI ───────────────────────────────────────────────────────────────
VTUBER_UI_WIDTH=480
VTUBER_UI_HEIGHT=780
VTUBER_UI_FPS=60

# ── Perilaku proaktif (dia menyapa sendiri saat ditinggal) ───────────────────
VTUBER_PROACTIVE=ya
# Detik menganggur sebelum dia membuka mulut sendiri. Minimum 60.
VTUBER_IDLE_SECONDS=300

# ── Voice-to-Voice (mikrofon) ────────────────────────────────────────────────
# Perlu `python main.py --voice-in` atau --voice-loop untuk memakainya.
VTUBER_VOICE_IN=tidak
# whisper | mock   (mock untuk menguji alur tanpa model STT)
VTUBER_STT_BACKEND=whisper
VTUBER_STT_MODEL=base
VTUBER_STT_LANG=id
VTUBER_STT_DEVICE=cpu
# Ambil mikrofon: laju sampel, ukuran blok, ambang VAD.
VTUBER_AUDIO_RATE=16000
VTUBER_AUDIO_BLOCK=320
VTUBER_VAD_RMS=500
# Nomor perangkat masuk tertentu; kosong = perangkat default sistem.
VTUBER_AUDIO_DEVICE=
