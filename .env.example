# Salin jadi .env lalu isi. .env tidak boleh ikut ke git.
GEMINI_API_KEY=
VTUBER_MODEL=gemini-3.5-flash
VTUBER_PORT=8787
# Suara. Ganti voiceName ke salah satu nama suara bawaan Gemini TTS.
VTUBER_TTS_MODEL=gemini-2.5-flash-preview-tts
VTUBER_TTS_VOICE=Kore
# Model penyalin suara. Free tier membatasi model ini sangat ketat (3/menit);
# kalau mentok, ganti ke gemini-3.5-flash yang kuotanya berbeda.
VTUBER_STT_MODEL=gemini-3.5-transcribe
