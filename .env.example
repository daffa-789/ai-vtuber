# Salin jadi .env lalu sesuaikan jika diperlukan. .env tidak boleh ikut ke git.
VTUBER_PORT=8787

# Wujud: 'pet' = jendela melayang tanpa bingkai di desktop (klik kanan = chat),
# 'browser' = Flask saja dan buka sendiri di tab. Halaman yang sama.
# Bisa juga per jalan: python main.py --browser
VTUBER_TAMPAK=pet

# ---- perilaku jendela pet ----
# "Tanpa jendela sama sekali" TIDAK BISA di mesin ini: menanam jendela ke lapisan
# desktop sudah dicoba dan gagal (lihat RENCANA-DESKTOP.md, Fase 1). Kesan itu
# karena itu dikejar lewat PERILAKU -- dia minggir saat memang tidak muat, dan
# Master selalu punya jalan kembali lewat tray + hotkey.
#
# Kapan dia minggir:
#   tidak (bawaan)       = selalu tampil. Ini bawaannya karena sembunyi-otomatis
#                          yang salah simpul membuat karakternya HILANG tanpa pesan
#                          -- jauh lebih buruk daripada satu jendela yang menempel.
#   layar-penuh          = hanya saat jendela depan menutupi SELURUH monitor,
#                          termasuk pita taskbar: video layar penuh, game.
#   maksimal             = juga saat jendela depan sekadar dimaksimalkan.
#                          HINDARI kalau kerja sehari-hari memakai jendela maksimal.
VTUBER_PET_SEMBUNYI=tidak
# Ikon tray: Tampilkan / Sembunyikan / Keluar. Jangan dimatikan selama
# VTUBER_PET_SEMBUNYI bukan 'tidak' -- itu satu-satunya jalan memanggilnya kembali.
VTUBER_PET_TRAY=ya
# Hotkey global untuk membuka/menutup kotak obrolan. Kosong = mati.
# Bentuk: ctrl+shift+s (urutan penahan bebas, huruf/angka terakhir).
VTUBER_PET_HOTKEY=ctrl+shift+s

# =====================================================================
# OTAK PERCAKAPAN (LLM 100% OFFLINE)
# =====================================================================
# Provider:
#   local / llama_cpp = model GGUF offline di folder model/, dihitung di CPU (bawaan)
#   vulkan            = GGUF yang SAMA, dihitung GPU terintegrasi lewat llama-server
#                       (proses anak yang dikelola main.py sendiri)
#   ollama            = daemon Ollama lokal di http://127.0.0.1:11434
VTUBER_LLM_PROVIDER=local
VTUBER_LOCAL_MODEL_PATH=model/Llama-3.2-3B-Instruct-Q4_K_M.gguf
VTUBER_LOCAL_MODEL_THREADS=4
VTUBER_LOCAL_MODEL_CTX=8192

# Jalur GPU terintegrasi (Iris Xe / Arc tanpa VRAM sendiri).
# Perlu llama-server.exe + DLL build Vulkan di bin/llama/
# Kalau binary belum ada, chat JATUH ke CPU dan banner mengatakannya -- bukan diam-diam.
# Lapis yang dititipkan ke GPU; 99 = semua.
VTUBER_VULKAN_NGL=99
# Flash attention. TANPA ini offload penuh justru kalah dari CPU di mesin ini.
VTUBER_VULKAN_FA=ya
# Simpan slot menganggur ke prompt cache -> persona panjang tidak dihitung ulang.
VTUBER_VULKAN_SLOT_DIAM=ya
# Panaskan saat boot: baca GGUF + kompilasi shader = 5-15 dtk, lebih baik di sini
# daripada di dalam kalimat pertama.
VTUBER_VULKAN_MUAT_BOOT=ya
VTUBER_VULKAN_PERANGKAT=Vulkan0
VTUBER_LLAMA_SERVER=bin/llama

# Opsi jika menggunakan Ollama:
VTUBER_OLLAMA_URL=http://127.0.0.1:11434
VTUBER_OLLAMA_MODEL=llama3.2:3b

# =====================================================================
# MIC LOKAL -- STT tanpa Web Speech API (yang itu mengunggah suara ke Google/MS)
# =====================================================================
# Perlu: pip install faster-whisper + folder model di aset/suara/whisper/<nama>/
VTUBER_STT=ya
# base (74 MB, cepat) | small (244 MB) | medium
VTUBER_STT_MODEL=base
VTUBER_STT_MODEL_PATH=aset/suara/whisper
VTUBER_STT_BAHASA=id
VTUBER_STT_KOMPUTASI=int8
# Jangan 4: llama-server juga meminta thread.
VTUBER_STT_THREADS=2
VTUBER_STT_BEAM=1
VTUBER_STT_MUAT_BOOT=tidak
VTUBER_STT_MAKS_DETIK=30

# =====================================================================
# SUARA LOKAL -- TTS bahasa Indonesia yang jalan tanpa internet & tanpa kuota
# =====================================================================
# Rantai engine offline: piper+rvc,piper
VTUBER_TTS_RANTAI=piper+rvc,piper
VTUBER_TTS_PER_KALIMAT=true
VTUBER_TTS_BATAS_DETIK=40
VTUBER_TTS_JEDA_RESEP=60

# Piper: TTS Indonesia offline (ONNX), jalan di CPU.
VTUBER_TTS_PIPER_MODEL=aset/suara/piper/id_ID-news_tts-medium.onnx
VTUBER_TTS_PIPER_SUARA=id_ID-news_tts-medium
VTUBER_TTS_PIPER_VOLUME=100
VTUBER_TTS_PIPER_PANJANG=0.9

# RVC: Mengubah warna suara (Furina)
VTUBER_RVC=ya
VTUBER_RVC_FOLDER=aset/suara/rvc
VTUBER_RVC_MODEL=furina
VTUBER_RVC_VERSI=v2
VTUBER_RVC_F0=rmvpe
VTUBER_RVC_TRANSPOSE=12
VTUBER_RVC_PROTEKSI=0.33
VTUBER_RVC_PENCUCIAN=3
VTUBER_RVC_CAMPUR_RMS=0.8
VTUBER_RVC_INDEKS_LAJU=0
VTUBER_RVC_RESAMPLE=0
VTUBER_RVC_MUAT_BOOT=ya
VTUBER_RVC_BATAS_ANTREAN=8

# Cache suara
VTUBER_TTS_CACHE=ya
VTUBER_TTS_CACHE_FOLDER=var/cache-suara
VTUBER_TTS_CACHE_MAKS_MB=250
VTUBER_TTS_METERIK=tidak

# Memori Obsidian
VTUBER_JEDA_FAKTA=8

# =====================================================================
# AVATAR -- semua wajah, pose, gerakan, dan ukuran gambar diatur di sini
# =====================================================================
# Cara pakai: sunting nilainya, muat ulang halaman (F5). Sidecar membaca ulang
# .env sendiri lewat ETag halaman; kalau nilainya terasa tidak masuk, muat ulang.
# Cek apa yang benar-benar terpakai: buka /perkakas.html saat server hidup
#
# Sintaks resep:   Id=Nilai   dipisah spasi (atau koma), boleh negatif.
#                  Blend default Add = MENAMBAH di atas nilai bawaan parameter.
#                  Id=Nilai:Overwrite untuk menulis mentah, :Multiply untuk mengali.
#                  Tulis "kosong" untuk ekspresi tanpa parameter (mis. netral).
# Nama kunci:     huruf besar jadi kecil, garis bawah jadi garis hubung.
#                  VITE_POSE_PAMER_BARANG_1  ->  pose "pamer-barang-1"
# Kata setelah VITE_WAJAH_ / VITE_POSE_ SELALU dianggap nama ekspresi, jadi knob
# lain memakai awalan sendiri (VITE_EKSPRESI_DASAR, VITE_AWAL_POSE).
# Baris yang dihapus atau dikomentari kembali ke bawaan di web/konfigurasi.js.
#
# Rentang parameter model ini TIDAK seragam: lapisan ekspresi/aksesoris 0..30,
# ParamEyeLOpen 0..1.4, ParamMouthOpenY 0..1. Kalau ada nilai yang keluar dari
# rentangnya, halaman memberi tahu lewat status "N konfigurasi perlu dicek".

# ---- ukuran gambar & ketajaman ----
# Berkas model3.json yang dirender.
VITE_MODEL_URL="/models/penyihir/penyihir.model3.json"

# Berapa piksel nyata yang digambar per 1 piksel CSS.
#   auto  = ikuti devicePixelRatio layar, termasuk saat zoom browser (paling tajam)
#   angka = paksa, misalnya 2 untuk super-sampling atau 1 untuk hemat
VITE_RENDER_SKALA="auto"

# Batas atas untuk mode auto. Zoom 300% di layar 125% berarti ~4x: itu tajam
# tapi mahal. Turunkan ke 2 (bawaan lama) kalau FPS terasa jatuh.
VITE_RENDER_SKALA_MAKS="8"

# Antialias WebGL. Matikan hanya untuk menghemat GPU.
VITE_RENDER_HALUS="true"

# Ukuran kotak avatar dalam CSS px -- ikut jejak kaki di layar, BUKAN jumlah
# pikselnya (itu tugas VITE_RENDER_SKALA). Boleh fungsi CSS: min(), calc(), vw/vh.
VITE_PANGGUNG_UKURAN="min(90vh, 100%)"
# Isi salah satu ini kalau kotaknya mau tidak persegi; kosong = ikut ukuran di atas.
VITE_PANGGUNG_LEBAR=
VITE_PANGGUNG_TINGGI=

# Bagian tinggi kotak yang boleh diisi karakter; 1 = penuh sampai ubun-ubun
# terpotong. Naikkan untuk membesar, turunkan untuk menjauh.
VITE_AVATAR_ZOOM="0.96"
# Posisi mendatar: 0 = tepi kiri, 0.5 = tengah, 1 = tepi kanan.
VITE_AVATAR_X="0.5"
# Jangkar vertikal: 1 = kaki menempel dasar, 0.5 = tengah badan di tengah, 0 = kepala di dasar.
VITE_AVATAR_JANGKAR="1"

# ---- gerakan hidup bawaan ----
VITE_KEDIP="true"
VITE_NAPAS="true"
# Kepala dan mata mengikuti kursor.
VITE_IKUTI_KURSOR="true"

# Atlas tekstur model (public/models/penyihir/tekstur).
# Model ini punya 8192; ukuran itu sudah maksimum yang tersedia dari aslinya.
VITE_TEKSTUR="8192"

# ---- irama render: hemat GPU saat avatar tidak sedang dilihat ----
# Berhenti menggambar SAMA SEKALI saat tab pindah ke latar atau jendela
# diminimakan -- yang dihemat bukan angka FPS, tapi permintaan GPU-nya.
VITE_IRAMA_JEDA_SAAT_SEMBUNYI="true"
# Batas FPS saat jendela terlihat TETAPI tidak fokus (overlay selalu-di-depan,
# atau tertutup jendela lain). 0 = biarkan penuh seperti saat fokus.
VITE_IRAMA_FPS_SAAT_TAK_FOKUS="30"

# ---- wajah (tag chat, satu wajah aktif pada satu waktu) ----
# Ekspresi saat halaman baru dibuka dan saat balasan tidak memakai tag.
VITE_EKSPRESI_DASAR="netral"
# Lama pudar antar wajah, dalam milidetik. Berkas .exp3.json hasil
# npm run pasang-model ikut memakai angka ini.
VITE_PUDAR_WAJAH_MS="1000"

VITE_WAJAH_NETRAL="kosong"
VITE_WAJAH_SENYUM="ParamMouthForm=1 ParamEyeLSmile=1 ParamEyeRSmile=1 ParamEyeLOpen=-0.35 ParamEyeROpen=-0.35 ParamBrowLY=0.2"
VITE_WAJAH_SEMANGAT="Param59=30 ParamMouthForm=1 ParamEyeLSmile=0.6 ParamEyeRSmile=0.6 ParamEyeLOpen=0.2 ParamEyeROpen=0.2 ParamBrowLY=0.5"
VITE_WAJAH_KAGET="ParamEyeLOpen=0.4 ParamEyeROpen=0.4 ParamBrowLY=1 ParamMouthForm=-0.6 Param50=0.7"
VITE_WAJAH_BINGUNG="Param69=30 ParamMouthForm=-0.4 ParamBrowLForm=-0.5 ParamBrowLY=-0.4"
VITE_WAJAH_LELAH="ParamEyeLOpen=-0.7 ParamEyeROpen=-0.7 ParamBrowLY=-0.5 ParamBrowLForm=-0.6 ParamMouthForm=-0.3"
VITE_WAJAH_GODA="Param60=30 ParamMouthForm=0.8 ParamEyeLOpen=-0.3 ParamEyeROpen=-0.3 ParamEyeLSmile=0.7 ParamEyeRSmile=0.7"
VITE_WAJAH_SEBAL="Param67=30 ParamBrowLForm=-0.879 ParamBrowLY=-0.727"
VITE_WAJAH_SEDIH="Param68=30 ParamBrowLForm=1 ParamBrowLY=-0.788"

# ---- pose & aksesoris ----
# Kanal TAG-nya terpisah dari wajah: [prop:tongkat] menyalakan, [prop:tongkat=mati]
# memadamkan. Pose ditulis paling akhir setiap frame, jadi dia TETAP di atas
# wajah apa pun -- menekan "sedih" tidak menghilangkan tongkat.
# Pose yang sudah menyala sejak halaman dibuka (nama dipisah spasi), misal:
#   VITE_AWAL_POSE="kacamata hantu-kecil"
VITE_AWAL_POSE=
VITE_POSE_TANPA_TOPI="Param71=30"
VITE_POSE_TONGKAT="Param72=30"
VITE_POSE_KACAMATA="Param66=30"
VITE_POSE_HANTU_KECIL="Param64=30"
VITE_POSE_TANGAN_MEMELUK="Param65=30"
VITE_POSE_PAMER_BARANG_1="Param61=30"
VITE_POSE_PAMER_BARANG_2="Param62=30"

# ---- gerakan (motion) ----
# grup   = nama grup di model3.json; berkas = path di DALAM folder model;
# sumber = nama berkas aslinya di folder sumber kalau berbeda; ulang = true
# untuk membiarkan motion berputar terus (berbahaya: parameter terakhir yang
# ia tulis akan tertinggal, contoh air mata). Bergerak dari .env butuh
# npm run pasang-model supaya berkasnya ikut dipasang.
VITE_GERAK_SEDIH_MELAMBAI="grup=isyarat berkas=gerakan/sedih-melambai.motion3.json sumber=Scene1.motion3.json ulang=false"
